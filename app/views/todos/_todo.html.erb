<div id="<%= dom_id todo %>" class="<%= "todo--high-priority" if todo.high_priority? %>">
  <% if todo.high_priority? %>
    <span class="todo__badge">High priority</span>
  <% end %>

  <div>
    <strong>Description:</strong>
    <%= todo.description %>
  </div>

  <div>
    <strong>Done:</strong>
    <%= todo.done ? "Yes" : "No" %>
  </div>

  <div>
    <strong>Due date:</strong>
    <%= todo.due_date %>
  </div>

  <div>
    <%= button_to(todo.high_priority? ? "Remove high priority" : "Mark high priority",
                  toggle_high_priority_todo_path(todo),
                  method: :patch) %>
  </div>
</div>
